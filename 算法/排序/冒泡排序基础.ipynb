   "source": [
    "a=list(input('排序：'))\n",
    "def bubble_sort(a):\n",
    "    for i in range(len(a)-1):\n",
    "        for j in range(i,len(a)):\n",
    "            if a[i]>a[j]:\n",
    "                a[i],a[j]=a[j],a[i]\n",
    "    return a*2\n",
    "print(bubble_sort(a))\n",
    "\n",
    "def funa():\n",
    "    print(__name__)\n",
    "funa()"
   ],
