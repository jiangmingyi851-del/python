    "content": [
      {
        "type": "text",
        "content": ""
      },
      {
        "type": "text",
        "content": "3.2   \u4e3b\u9898\u7535\u5f71\u7c7b \u00d7 \u5e74\u9f84\u76f8\u5173\u6027\u5efa\u6a21"
      },
      {
        "type": "text",
        "content": ""
      },
      {
        "type": "text",
        "content": "\u2460 \u95ee\u9898\u52a8\u673a\ngenre \u662f\u7ed9\u5b9a\u79bb\u6563\u6807\u7b7e; \u8fd9\u91cc\u7528\u65e0\u76d1\u7763\u4e3b\u9898\u6a21\u578b\u4ece intro \u91cd\u65b0\u62bd\"\u8bed\u4e49\u4e3b\u9898\",\n\u7814\u7a76\u54ea\u4e9b\u4e3b\u9898\u7684\u504f\u597d\u968f\u5e74\u9f84\u663e\u8457\u53d8\u5316\u3002\n\u2461 \u516c\u5f0f\n  LDA: \u7535\u5f71 d \u7684\u4e3b\u9898\u5206\u5e03 \u03c0_d \u2208 \u0394^{K-1}\n  \u533a\u5206\u5ea6: discrim_k = (1/|Age|) \u03a3_a (r\u0304_ka \u2212 r\u0304_k)\u00b2\n\u03c0_dk: \u7535\u5f71 d \u5c5e\u4e3b\u9898 k \u7684\u6982\u7387; r\u0304_ka: \u5e74\u9f84\u6bb5 a \u5bf9\u4e3b\u9898 k \u7684\n\u52a0\u6743\u5e73\u5747\u8bc4\u5206\u3002\u6309 discrim_k \u81ea\u52a8\u6311\u6700\u5177\u5e74\u9f84\u533a\u5206\u5ea6\u7684 3 \u4e2a\u4e3b\u9898\u3002\n\u2462 \u5b9e\u73b0\u6b65\u9aa4\nStep1 LDA(K=6) \u62bd\u4e3b\u9898 \u2192 Step2 \u9009 top3 \u533a\u5206\u5ea6\u4e3b\u9898\nStep3 \u4e3b\u9898\u00d7\u5e74\u9f84 \u70ed\u56fe/\u6298\u7ebf \u2192 Step4 \u4ea4\u4e92\u9879 OLS \u663e\u8457\u6027"
      },
      {
        "type": "text",
        "content": "\u2463\u2464\u2465 Top \u5e74\u9f84\u654f\u611f\u4e3b\u9898 & \u7ed3\u8bba\nt1: love, man, falls, woman, young\nt2: war, world, ii, group, evil\nt5: new, life, york, new york, city\n\u5404\u4e3b\u9898\u5e73\u5747\u5206\u90fd\u968f\u5e74\u9f84\u5347\u9ad8 \u2192 \u5e74\u957f\u7528\u6237\u6574\u4f53\u6253\u5206\u66f4\u5bbd\u5bb9;\n\u6218\u4e89/\u5386\u53f2\u4e3b\u9898\u7684\u5e74\u9f84\u68af\u5ea6\u6700\u9661, \u90fd\u5e02/\u7231\u60c5\u4e3b\u9898\u76f8\u5bf9\u5e73\u7f13\u3002"
      }
    ],
