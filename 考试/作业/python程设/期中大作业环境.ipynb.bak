      "10            Romance|Drama|Comedy\n",
      "11           Comedy|Horror|Fantasy\n",
      "12        Adventure|Drama|Thriller\n",
      "13                           Drama\n",
      "14         Adventure|Action|Comedy\n",
      "15            Crime|Thriller|Drama\n",
      "16                   Romance|Drama\n",
      "17           Drama|Mystery|Romance\n",
